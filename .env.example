# Скопируйте в .env и заполните. Ключи берутся на https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# Необязательно: путь к файлу сессии (по умолчанию giveaway_finder.session рядом со скриптом)
# TG_SESSION=giveaway_finder
# Или строка сессии (см. последнюю ячейку giveaway_finder_colab.ipynb) — удобно для облака
# TG_STRING_SESSION=
